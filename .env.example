# Copy to .env and fill in. .env is git-ignored; never commit it.

# The model: any OpenAI-compatible endpoint whose model supports tool calling.
AGENT_API_BASE=https://api.openai.com/v1
AGENT_API_KEY=
AGENT_MODEL=
# Optional provider-specific request options, as JSON.
# AGENT_EXTRA_BODY={}

# Optional: "Sign in with SmartThings" (OAuth). Leave empty to sign in with a
# personal access token instead. See the README for creating the OAuth app.
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_REDIRECT_URI=http://localhost:5173/
