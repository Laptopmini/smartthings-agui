{
  "name": "smartthings-agui",
  "version": "0.1.0",
  "private": true,
  "description": "Talk to your SmartThings home from any AG-UI agent: CopilotKit frontend tools, A2UI device cards, and confirmation before anything security-sensitive.",
  "keywords": [
    "smartthings",
    "ag-ui",
    "copilotkit",
    "a2ui",
    "smart-home",
    "frontend-tools",
    "agent"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/Laptopmini/smartthings-agui#readme",
  "bugs": "https://github.com/Laptopmini/smartthings-agui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laptopmini/smartthings-agui.git",
    "directory": "packages/smartthings-agui"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config vite.build.config.ts && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a2ui/web_core": "0.10.4",
    "@copilotkit/a2ui-renderer": "1.79.0"
  },
  "peerDependencies": {
    "@copilotkit/react-core": "1.79.0",
    "react": "^19",
    "zod": ">=3.25.0"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.2",
    "@copilotkit/react-core": "1.79.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "zod": "4.6.7",
    "zod-v3-types": "npm:zod@3.25.76"
  }
}
